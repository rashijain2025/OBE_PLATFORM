PORT=5001
MONGODB_URI=mongodb://localhost:27017/obe_platform
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
NODE_ENV=development
CO_TARGET=60
ML_SERVICE_URL=http://localhost:8000

# Admin Credentials (Upserted on server startup, password minimum 12 chars)
ADMIN_EMAIL=admin@mitsgwalior.in
ADMIN_PASSWORD=change_this_admin_password_12_chars
ADMIN_NAME=System Administrator

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=mitsgwalior.in

# Auth Features
ENABLE_PASSWORD_LOGIN=true

# Demo Seed Configuration
DEMO_COORDINATOR_EMAIL=coordinator@mitsgwalior.in

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@mitsgwalior.in
SMTP_PASS=your_app_specific_password
MAIL_FROM="MITS OBE Platform" <noreply@mitsgwalior.in>
FRONTEND_URL=http://localhost:5173
