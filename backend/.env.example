# Server Configuration
PORT=5001
NODE_ENV=production

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/obe_platform?retryWrites=true&w=majority
# MONGODB_URI is also supported as an alias
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/obe_platform?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated, no wildcard in production)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-frontend.vercel.app

# JWT Authentication
JWT_SECRET=your_strong_random_jwt_secret_here
JWT_EXPIRE=7d

# Microservices
ML_SERVICE_URL=https://your-ml-service.onrender.com
ML_TIMEOUT_MS=60000

# Admin Credentials (Upserted on server startup, password minimum 12 chars)
ADMIN_EMAIL=admin@mitsgwalior.in
ADMIN_PASSWORD=ChangeThisAdminPassword12CharsMin!
ADMIN_NAME=System Administrator

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=mitsgwalior.in,gmail.com

# Auth Features
ENABLE_PASSWORD_LOGIN=true
CO_TARGET=60

# SMTP Email Configuration (Nodemailer for Coordinator Faculty Invites)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
MAIL_FROM="MITS OBE Platform" <noreply@mitsgwalior.in>
