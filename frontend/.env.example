# Backend API URL (Points to the deployed Render backend service + /api)
VITE_API_URL=https://your-backend.onrender.com/api

# Google OAuth Client ID for Institute / Staff Sign-In
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional direct ML Microservice URL (if directly querying ML health from frontend)
VITE_ML_URL=https://your-ml-service.onrender.com
